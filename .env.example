# Test notification channels for local development.
#
#   cp .env.example .env      # .env is gitignored; this file is not
#   # uncomment and fill in one or more channels below, then:
#   set -a; source .env; set +a
#
# Use TEST channels here, never the ones your real alerts go to.
# Everything starts commented out on purpose: a channel with only some of
# its variables set makes startup fail. See docs/SETUP.md § 9.

# --- Discord: the webhook of a private test channel ------------------
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Telegram: a separate test bot from @BotFather -------------------
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# --- Email, option A: Mailtrap Email Testing (catches all mail) -------
# Credentials: Mailtrap → Email Testing → your inbox → SMTP settings.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# NOTIFY_EMAIL_TO=me@example.com
# NOTIFY_EMAIL_FROM=astro-task-runner@example.com

# --- Email, option B: Mailpit on your machine (no account needed) -----
# docker run --rm -p 1025:1025 -p 8025:8025 \
#   -e MP_SMTP_AUTH_ACCEPT_ANY=1 -e MP_SMTP_AUTH_ALLOW_INSECURE=1 axllent/mailpit
# Inbox at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=dev
# SMTP_PASSWORD=dev
# SMTP_STARTTLS=false
# NOTIFY_EMAIL_TO=me@example.com
