<configuration>
    <!-- Plain text in tests, for readable output. Production is JSON (main/resources/logback.xml). -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg %kvp %mdc%n</pattern>
        </encoder>
    </appender>

    <logger name="com.icegreen.greenmail" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
